{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gfrmin/tannen/tests/laws/m5/measurement/schema.json",
  "title": "measurement/1 — the M5 vertical-selection measurement (docs/specs/m5.md §2)",
  "description": "One record per gate sitting. Each candidate is a Renavon source with its declared visible export, the parser files counted, the parser's line count under counter loc/1, and the tannen operators its vertical would require. Operator NAMES are constrained only in shape here; membership in tannen's catalogue is derived from the package by L5.4, never listed in this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tannen", "counter", "candidates"],
  "properties": {
    "tannen": {"const": "measurement/1"},
    "counter": {"enum": ["loc/1"]},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "visible_export", "parser_files", "parser_loc", "operators"],
        "properties": {
          "source": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "visible_export": {"type": "boolean"},
          "parser_files": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "parser_loc": {"type": "integer", "minimum": 1},
          "operators": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z_]*$"}
          }
        }
      }
    }
  }
}
