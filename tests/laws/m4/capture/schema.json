{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tannen:capture/1",
  "title": "capture/1 — an oracle invocation's immutable record (docs/specs/m4.md §3)",
  "description": "FROZEN at m4-laws-freeze. Written to the store BEFORE anything reads the value it holds (BRIEF P1, §4). Owned by tannen [owns]; Grade-S shape (BRIEF §2.1), vectors beside it. Money is an exact integer in the named unit, never a float. A Fetch body is held by content address, never inline. Header lists are ordered pairs and may repeat, as in a WARC record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tannen", "kind", "oracle", "input_key", "request", "response", "scope", "unit", "price", "reservation"],
  "properties": {
    "tannen": {"const": "capture/1"},
    "kind": {"enum": ["fetch", "llm", "clock"]},
    "oracle": {"$ref": "#/$defs/ref"},
    "input_key": {"$ref": "#/$defs/ref"},
    "request": {"type": "object"},
    "response": {"type": "object"},
    "scope": {"type": "string", "minLength": 1},
    "unit": {"type": "string", "minLength": 1},
    "price": {"type": "integer", "minimum": 0},
    "reservation": {"$ref": "#/$defs/ref"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "fetch"}}, "required": ["kind"]},
      "then": {"properties": {"request": {"$ref": "#/$defs/fetchRequest"}, "response": {"$ref": "#/$defs/fetchResponse"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "llm"}}, "required": ["kind"]},
      "then": {"properties": {"request": {"$ref": "#/$defs/llmRequest"}, "response": {"$ref": "#/$defs/llmResponse"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "clock"}}, "required": ["kind"]},
      "then": {"properties": {"request": {"$ref": "#/$defs/clockRequest"}, "response": {"$ref": "#/$defs/clockResponse"}}}
    }
  ],
  "$defs": {
    "ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "instant": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "headers": {
      "type": "array",
      "items": {"type": "array", "prefixItems": [{"type": "string", "minLength": 1}, {"type": "string"}], "minItems": 2, "maxItems": 2}
    },
    "fetchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "uri", "headers"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "headers": {"$ref": "#/$defs/headers"}
      }
    },
    "fetchResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "headers", "body", "observed_at"],
      "properties": {
        "status": {"type": "integer", "minimum": 100, "maximum": 599},
        "headers": {"$ref": "#/$defs/headers"},
        "body": {"$ref": "#/$defs/ref"},
        "observed_at": {"$ref": "#/$defs/instant"}
      }
    },
    "llmRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "prompt", "tool_schema", "params", "messages"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "prompt": {"type": "string"},
        "tool_schema": {},
        "params": {"type": "object", "required": ["max_tokens"], "properties": {"max_tokens": {"type": "integer", "minimum": 1}}},
        "messages": {
          "type": "array",
          "items": {"type": "object", "required": ["role", "content"], "properties": {"role": {"type": "string", "minLength": 1}}}
        }
      }
    },
    "llmResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolved_model", "content", "usage"],
      "properties": {
        "resolved_model": {"type": "string", "minLength": 1},
        "content": {},
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "output_tokens"],
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "clockRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {"label": {"type": "string", "minLength": 1}}
    },
    "clockResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instant"],
      "properties": {"instant": {"$ref": "#/$defs/instant"}}
    }
  }
}
